# ===========================================
# ENERGY TRADING PLATFORM - CONFIG TEMPLATE
# ===========================================

# Application
NODE_ENV=production
PORT=4000
KWH_TO_ZMW_RATE=1.2
CARBON_SAVINGS_PER_KWH=0.8

MINIMUM_STAKE_PCU=100
VALIDATOR_REWARD_PCT=0.05
ZESCO_TARIFF_SYNC_ENABLED=true
ZESCO_TARIFF_SOURCE_URL=https://www.erb.org.zm/tariffs

# AWS DynamoDB
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DYNAMODB_TABLE=

# Security
JWT_SECRET=
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:5173

# MTN MOBILE MONEY
MTN_ENVIRONMENT=production
MTN_API_KEY=
MTN_API_SECRET=
MTN_SUBSCRIPTION_KEY=
MTN_TARGET_ENVIRONMENT=mtnzambia
MTN_CALLBACK_URL=

# AIRTEL MONEY
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_API_KEY=
AIRTEL_CALLBACK_URL=
AIRTEL_COUNTRY=ZM
AIRTEL_MERCHANT_PIN=

# WEBHOOK SECRETS
MTN_WEBHOOK_SECRET=
AIRTEL_WEBHOOK_SECRET=

# Frontend
VITE_API_URL=http://localhost:3000

EXCHANGE_RATE_API_KEY=
FALLBACK_USD_ZMW_RATE=27.50
LOG_LEVEL=info

# Legacy Supabase (active application during migration only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=
DB_POOL_SIZE=15

# V2 Supabase (target database; never fall back to legacy variables)
V2_SUPABASE_URL=
V2_SUPABASE_SERVICE_ROLE_KEY=
VITE_V2_SUPABASE_URL=
VITE_V2_SUPABASE_PUBLISHABLE_KEY

# Enerlectra
ENERLECTRA_OPERATOR_TOKEN=

# Lenco
LENCO_BASE_URL=https://api.lenco.co/access/v2/
LENCO_PUBLIC_KEY=
LENCO_SECRET_KEY=
LENCO_ACCOUNT_ID=
LENCO_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# AuthKey
AUTHKEY_API_TOKEN=
AUTHKEY_ELLIE_TEMPLATE_ID=
AUTHKEY_COUNTRY_CODE=260

# PostHog
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
