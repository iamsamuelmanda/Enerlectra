{
  "name": "enerlectra-os",
  "version": "2.4.0",
  "private": true,
  "description": "Enerlectra OS — Decoupled Energy Management Kernel",
  "type": "module",
  "main": "server/src/index.ts",
  "scripts": {
    "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') { try { require('husky').install() } catch (e) {} }\"",
    "start": "tsx -r tsconfig-paths/register ./server/src/index.ts",
    "dev": "tsx ./server/src/index.ts",
    "build": "npm run build:client",
    "build:client": "cd client && npx vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck:server": "tsc -p tsconfig.ci-server.json",
    "typecheck:client": "cd client && npx tsc --noEmit",
    "typecheck:telegram-bot": "cd integrations/telegram-bot && npx tsc --noEmit",
    "test": "node --import tsx --test test/ci-smoke.test.mjs test/v2-boundary.test.mjs test/v2-tenant-context.test.mjs && npm run test:v2:command-tenant-context && npm run test:v2:runtime-boundary",
    "ci": "npm test && npm run typecheck:server && npm run typecheck:client && npm run build:client && npm run typecheck:telegram-bot",
    "clean": "rm -rf dist client/dist",
    "test:v2:action": "node --import tsx --test test/v2-action-integration.test.mjs",
    "test:customer-operational-issue": "node --import tsx --test test/customer-operational-issue.test.mjs",
    "test:v2:customer-operational-issue": "node --import tsx --test test/v2-customer-operational-issue-integration.test.mjs",
    "test:v2:action-http": "node --import tsx --test test/v2-action-http-integration.test.mjs",
    "test:v2:command-tenant-context": "node --import tsx --test test/v2-command-tenant-context.test.mjs",
    "test:v2:runtime-boundary": "node --import tsx --test test/v2-runtime-boundary.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.8.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "enerlectra-core": "file:./enerlectra-core",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "framer-motion": "^11.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.446.0",
    "morgan": "^1.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.47",
    "posthog-node": "^5.41.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.5",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.13",
    "telegraf": "^4.16.3",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "uuid": "^10.0.0",
    "vite": "^8.0.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tsconfig-paths": "^4.2.0"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  }
}
